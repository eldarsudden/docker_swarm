swarm_docker() {
  timeout 5s {{ _docker_swarm_cli }} "$@"
}

{% raw %}
swarm_local_state() {
  swarm_docker info --format '{{.Swarm.LocalNodeState}} {{.Swarm.ControlAvailable}} {{.Swarm.NodeID}}'
}

swarm_data_root() {
  swarm_docker info --format '{{.DockerRootDir}}'
}

swarm_manager_can_stop() {
  local node_id="$1" allow_single="$2" autolock managers

  autolock=$(swarm_docker info --format '{{.Swarm.Cluster.Spec.EncryptionConfig.AutoLockManagers}}') || return 27
  case "$autolock" in
    false) ;;
    true)
      echo "Swarm manager autolock requires manual unlock after restart." >&2
      return 26
      ;;
    *)
      echo "Docker did not report the Swarm autolock setting." >&2
      return 27
      ;;
  esac

  managers=$(swarm_docker node ls --filter role=manager --format '{{.ID}} {{.ManagerStatus}}') || return 28
  printf '%s\n' "$managers" | awk -v node_id="$node_id" -v allow_single="$allow_single" '
    NF {
      total++
      if ($1 == node_id) {
        self = ($2 == "Leader" || $2 == "Reachable")
      } else if ($2 == "Leader" || $2 == "Reachable") {
        others++
      }
    }
    END {
      needed = int(total / 2) + 1
      if (!self || !((total == 1 && allow_single == "true") || others >= needed)) {
        printf "Reachable peer managers: %d of %d required (%d managers total).\n", others, needed, total
        if (!self) print "The target manager is missing or unreachable in the Swarm manager list."
        exit 1
      }
    }
  ' >&2 || return 22
}

swarm_wait_for_manager() {
  local node_id="$1" attempt=0
  while [ "$attempt" -lt 30 ]; do
    if [ "$(swarm_docker node inspect "$node_id" --format '{{.Status.State}} {{.ManagerStatus.Reachability}}' 2>/dev/null)" = 'ready reachable' ]; then
      return 0
    fi
    attempt=$((attempt + 1))
    sleep 2
  done
  echo "Swarm manager $node_id did not return to Ready and Reachable." >&2
  return 1
}
{% endraw %}
